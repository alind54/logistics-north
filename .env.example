# App
APP_ENV=development
APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=change-me-long-random-string-at-least-32-chars
PASSWORD_PEPPER=change-me-long-random-string-at-least-32-chars

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/request_tracker?schema=public

# Attachments (choose one)
# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Email (optional for password reset / verification)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

# Observability (optional)
SENTRY_DSN=
