# App
APP_ENV=development
APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=change-me-long-random-string-at-least-32-chars
PASSWORD_PEPPER=change-me-long-random-string-at-least-32-chars

# Database (Supabase)
# PgBouncer pooler connection (port 6543, with pgbouncer=true to disable prepared statements)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432, for prisma migrate / prisma db push)
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Attachments (choose one)
# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Email (optional for password reset / verification)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

# Observability (optional)
SENTRY_DSN=
